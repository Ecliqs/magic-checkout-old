{"sections":{"main":{"type":"main-page","settings":{"color_scheme":"","show_title":true,"page_width":"xs"}},"custom_liquid_RcBJyD":{"type":"custom-liquid","name":"t:sections.custom_liquid.presets.custom_liquid.name","settings":{"color_scheme":"","separate_section_with_border":true,"remove_vertical_spacing":false,"remove_horizontal_spacing":false,"liquid":"<div id=\"app\" style=\"font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">\n  <style>\n    * { box-sizing: border-box; }\n    body { margin: 0; }\n\n    .container { max-width: 600px; margin: 0 auto; padding: 20px; }\n\n    .hero {\n      background: linear-gradient(135deg, #f4a460 0%, #cd853f 100%);\n      color: white;\n      padding: 60px 20px;\n      text-align: center;\n      border-radius: 8px 8px 0 0;\n      margin-bottom: 0;\n    }\n\n    .hero h1 { margin: 0 0 15px 0; font-size: 32px; }\n    .hero p { margin: 0; font-size: 18px; opacity: 0.9; }\n\n    .form-container {\n      background: white;\n      padding: 40px 30px;\n      border-radius: 0 0 8px 8px;\n      box-shadow: 0 2px 8px rgba(0,0,0,0.1);\n      margin-bottom: 40px;\n    }\n\n    .form-group { margin-bottom: 20px; }\n\n    label {\n      display: block;\n      font-weight: 600;\n      margin-bottom: 8px;\n      color: #333;\n    }\n\n    input {\n      width: 100%;\n      padding: 12px;\n      border: 1px solid #ddd;\n      border-radius: 4px;\n      font-size: 16px;\n      box-sizing: border-box;\n    }\n\n    input:focus {\n      outline: none;\n      border-color: #cd853f;\n      box-shadow: 0 0 0 3px rgba(205, 133, 63, 0.1);\n    }\n\n    .error {\n      color: #dc3545;\n      font-size: 13px;\n      margin-top: 5px;\n      display: none;\n    }\n\n    button {\n      width: 100%;\n      padding: 12px;\n      background: #cd853f;\n      color: white;\n      border: none;\n      border-radius: 4px;\n      font-size: 16px;\n      font-weight: 600;\n      cursor: pointer;\n      margin-top: 10px;\n    }\n\n    button:hover { background: #b8750c; }\n\n    button:disabled {\n      opacity: 0.6;\n      cursor: not-allowed;\n    }\n\n    .success-message {\n      background: #d4edda;\n      color: #155724;\n      padding: 15px;\n      border-radius: 4px;\n      margin-bottom: 20px;\n      display: none;\n    }\n\n    .benefits {\n      background: #f9f9f9;\n      padding: 30px;\n      border-radius: 8px;\n      margin-bottom: 40px;\n    }\n\n    .benefits h3 { margin-top: 0; color: #cd853f; }\n\n    .benefits ul {\n      margin: 0;\n      padding-left: 20px;\n    }\n\n    .benefits li {\n      margin-bottom: 10px;\n      color: #666;\n    }\n  <\/style>\n\n  <div class=\"container\">\n    <div class=\"hero\">\n      <h1>You've experienced ATHLOUN style.<br>Now discover ATHLOUN values.<\/h1>\n      <p>Compare corporate piece vs. retail collection<\/p>\n    <\/div>\n\n    <div class=\"form-container\" id=\"form-wrapper\">\n      <h2 style=\"text-align: center; margin-top: 0; color: #333;\">Inner Circle Program<\/h2>\n      <p style=\"text-align: center; color: #666;\">Enter your company code and work email to verify and activate your 15% discount<\/p>\n\n      <form id=\"verification-form\">\n        <div class=\"form-group\">\n          <label for=\"company_code\">Company Code *<\/label>\n          <input\n            type=\"text\"\n            id=\"company_code\"\n            placeholder=\"e.g., LEAD2024\"\n            required\n          \/>\n          <div class=\"error\" id=\"code-error\"><\/div>\n        <\/div>\n\n        <div class=\"form-group\">\n          <label for=\"work_email\">Work Email *<\/label>\n          <input\n            type=\"email\"\n            id=\"work_email\"\n            placeholder=\"name@company.com\"\n            required\n          \/>\n          <div class=\"error\" id=\"email-error\"><\/div>\n        <\/div>\n\n        <div class=\"success-message\" id=\"success-message\">\n          ✓ Success! Your discount code has been generated. Check the code below.\n        <\/div>\n\n        <button type=\"submit\" id=\"submit-btn\">Verify & Activate<\/button>\n      <\/form>\n\n      <div id=\"code-display\" style=\"display: none; margin-top: 30px;\">\n        <div style=\"background: white; border: 3px solid #cd853f; padding: 30px; border-radius: 8px;\">\n          <p style=\"color: #666; margin: 0 0 10px 0;\">Your Discount Code:<\/p>\n          <h1 id=\"display-code\" style=\"color: #cd853f; margin: 0; letter-spacing: 2px; font-size: 32px;\"><\/h1>\n          <button type=\"button\" id=\"copy-btn\" onclick=\"copyCode()\" style=\"margin-top: 10px; background: #cd853f;\">\n            Copy Code\n          <\/button>\n        <\/div>\n      <\/div>\n    <\/div>\n\n    <div class=\"benefits\">\n      <h3>✓ Your Inner Circle Benefits<\/h3>\n      <ul>\n        <li><strong>15% OFF<\/strong> all purchases<\/li>\n        <li><strong>Free shipping<\/strong> on all orders<\/li>\n        <li><strong>Early access<\/strong> to new collections<\/li>\n        <li><strong>Lifetime discount<\/strong> - never expires<\/li>\n      <\/ul>\n      <p style=\"font-size: 12px; color: #999; margin-top: 20px;\">Note: NO COD ORDERS<\/p>\n    <\/div>\n  <\/div>\n<\/div>\n\n<script>\nconst API_BASE = 'https:\/\/athloun-inner-circle-api.onrender.com\/api';\n\nfunction showError(id, msg) {\n  const el = document.getElementById(id);\n  if (el) {\n    el.textContent = msg;\n    el.style.display = 'block';\n  }\n}\n\nfunction clearErrors() {\n  ['code-error', 'email-error'].forEach(id => {\n    const el = document.getElementById(id);\n    if (el) {\n      el.style.display = 'none';\n      el.textContent = '';\n    }\n  });\n}\n\n\/\/ PAGE LOAD\ndocument.addEventListener('DOMContentLoaded', () => {\n  const params = new URLSearchParams(window.location.search);\n  const token = params.get('token');\n  const email = params.get('email');\n\n  if (token && email) {\n    \/\/ verification mode\n    const app = document.getElementById('app');\n    app.innerHTML = '<div style=\"text-align:center;padding:60px 20px;\"><h2>Verifying...<\/h2><\/div>';\n    verifyEmail(token, email);\n    return;\n  }\n\n  \/\/ normal form mode\n  const form = document.getElementById('verification-form');\n  if (!form) return;\n\n  form.addEventListener('submit', async (e) => {\n    e.preventDefault();\n\n    clearErrors();\n\n    const company_code = document.getElementById('company_code').value.trim();\n    const work_email = document.getElementById('work_email').value.trim();\n    const btn = document.getElementById('submit-btn');\n\n    if (!company_code) {\n      showError('code-error', 'Please enter company code');\n      return;\n    }\n    if (!work_email) {\n      showError('email-error', 'Please enter work email');\n      return;\n    }\n\n    btn.disabled = true;\n    btn.textContent = 'Sending...';\n\n    try {\n      const resp = await fetch(`${API_BASE}\/verify-form`, {\n        method: 'POST',\n        headers: {\n          'Content-Type': 'application\/json',\n          'Accept': 'application\/json'\n        },\n        body: JSON.stringify({ company_code, work_email })\n      });\n\n      const data = await resp.json().catch(() => ({}));\n\n      if (resp.ok && data.success) {\n        document.getElementById('verification-form').style.display = 'none';\n        const msg = document.getElementById('success-message');\n        msg.textContent = data.message || 'Check your email for the verification link.';\n        msg.style.display = 'block';\n      } else {\n        const err = data.error || 'Something went wrong. Please try again.';\n        if (err.toLowerCase().includes('email')) {\n          showError('email-error', err);\n        } else {\n          showError('code-error', err);\n        }\n        btn.disabled = false;\n        btn.textContent = 'Verify & Activate';\n      }\n    } catch (err) {\n      console.error('Fetch error:', err);\n      showError('code-error', 'Connection error. Please try again.');\n      btn.disabled = false;\n      btn.textContent = 'Verify & Activate';\n    }\n  });\n});\n\n\/\/ VERIFY EMAIL FLOW\nasync function verifyEmail(token, email) {\n  try {\n    const resp = await fetch(\n      `${API_BASE}\/verify-email?token=${encodeURIComponent(token)}&email=${encodeURIComponent(email)}`\n    );\n    const data = await resp.json().catch(() => ({}));\n\n    if (resp.ok && data.success) {\n      const html = `\n        <div style=\"max-width: 600px; margin: 0 auto; padding: 60px 20px; text-align: center;\">\n          <div style=\"font-size: 80px; margin-bottom: 20px;\">✓<\/div>\n          <h1 style=\"color: #27ae60; margin: 0 0 10px 0;\">Email Verified!<\/h1>\n          <p style=\"color: #666; margin: 20px 0;\">Welcome to ATHLOUN Inner Circle, ${data.first_name || 'Member'}!<\/p>\n\n          <div style=\"background: white; border: 3px solid #cd853f; padding: 30px; border-radius: 8px; margin: 30px 0;\">\n            <p style=\"color: #666; margin: 0 0 10px 0;\">Your Discount Code:<\/p>\n            <h1 style=\"color: #cd853f; margin: 0; letter-spacing: 2px; font-size: 32px;\">${data.discount_code || ''}<\/h1>\n            <button onclick=\"navigator.clipboard.writeText('${data.discount_code || ''}'); alert('Copied!')\"\n              style=\"background: #cd853f; color: white; padding: 10px 20px; border: none; border-radius: 4px; cursor: pointer; margin-top: 10px;\">\n              Copy Code\n            <\/button>\n          <\/div>\n\n          <h3 style=\"color: #333;\">How to Use Your Discount:<\/h3>\n          <ol style=\"text-align: left; display: inline-block; color: #666;\">\n            <li>Browse our store<\/li>\n            <li>Add items to your cart<\/li>\n            <li>At checkout, enter code: <strong>${data.discount_code || ''}<\/strong><\/li>\n            <li>Get 15% off instantly!<\/li>\n          <\/ol>\n        <\/div>\n      `;\n      document.getElementById('app').innerHTML = html;\n    } else {\n      const err = data.error || 'Verification failed.';\n      document.getElementById('app').innerHTML = `\n        <div style=\"max-width: 600px; margin: 0 auto; padding: 60px 20px; text-align: center;\">\n          <h1 style=\"color: #dc3545;\">Verification Failed<\/h1>\n          <p>${err}<\/p>\n          <a href=\"\/pages\/insider\" style=\"color: #cd853f;\">Try again<\/a>\n        <\/div>\n      `;\n    }\n  } catch (err) {\n    console.error('Verify email error:', err);\n    document.getElementById('app').innerHTML = `\n      <div style=\"max-width: 600px; margin: 0 auto; padding: 60px 20px; text-align: center;\">\n        <h1 style=\"color: #dc3545;\">Error<\/h1>\n        <p>An error occurred. Please try again.<\/p>\n        <a href=\"\/pages\/insider\" style=\"color: #cd853f;\">Try again<\/a>\n      <\/div>\n    `;\n  }\n}\n<\/script>","text_alignment":"center"}}},"order":["main","custom_liquid_RcBJyD"]}