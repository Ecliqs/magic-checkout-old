{"sections":{"main":{"type":"main-page","settings":{"color_scheme":"","show_title":true,"page_width":"xs"}},"custom_liquid_RcBJyD":{"type":"custom-liquid","name":"t:sections.custom_liquid.presets.custom_liquid.name","settings":{"color_scheme":"","separate_section_with_border":true,"remove_vertical_spacing":false,"remove_horizontal_spacing":false,"liquid":"\u003cdiv id=\"app\" style=\"font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\"\u003e\n  \u003cstyle\u003e\n    * { box-sizing: border-box; }\n    body { margin: 0; }\n\n    .container { max-width: 600px; margin: 0 auto; padding: 20px; }\n\n    .hero {\n      background: linear-gradient(135deg, #f4a460 0%, #cd853f 100%);\n      color: white;\n      padding: 60px 20px;\n      text-align: center;\n      border-radius: 8px 8px 0 0;\n      margin-bottom: 0;\n    }\n\n    .hero h1 { margin: 0 0 15px 0; font-size: 32px; }\n    .hero p { margin: 0; font-size: 18px; opacity: 0.9; }\n\n    .form-container {\n      background: white;\n      padding: 40px 30px;\n      border-radius: 0 0 8px 8px;\n      box-shadow: 0 2px 8px rgba(0,0,0,0.1);\n      margin-bottom: 40px;\n    }\n\n    .form-group { margin-bottom: 20px; }\n\n    label {\n      display: block;\n      font-weight: 600;\n      margin-bottom: 8px;\n      color: #333;\n    }\n\n    input {\n      width: 100%;\n      padding: 12px;\n      border: 1px solid #ddd;\n      border-radius: 4px;\n      font-size: 16px;\n      box-sizing: border-box;\n    }\n\n    input:focus {\n      outline: none;\n      border-color: #cd853f;\n      box-shadow: 0 0 0 3px rgba(205, 133, 63, 0.1);\n    }\n\n    .error {\n      color: #dc3545;\n      font-size: 13px;\n      margin-top: 5px;\n      display: none;\n    }\n\n    button {\n      width: 100%;\n      padding: 12px;\n      background: #cd853f;\n      color: white;\n      border: none;\n      border-radius: 4px;\n      font-size: 16px;\n      font-weight: 600;\n      cursor: pointer;\n      margin-top: 10px;\n    }\n\n    button:hover { background: #b8750c; }\n\n    button:disabled {\n      opacity: 0.6;\n      cursor: not-allowed;\n    }\n\n    .success-message {\n      background: #d4edda;\n      color: #155724;\n      padding: 15px;\n      border-radius: 4px;\n      margin-bottom: 20px;\n      display: none;\n    }\n\n    .benefits {\n      background: #f9f9f9;\n      padding: 30px;\n      border-radius: 8px;\n      margin-bottom: 40px;\n    }\n\n    .benefits h3 { margin-top: 0; color: #cd853f; }\n\n    .benefits ul {\n      margin: 0;\n      padding-left: 20px;\n    }\n\n    .benefits li {\n      margin-bottom: 10px;\n      color: #666;\n    }\n  \u003c\/style\u003e\n\n  \u003cdiv class=\"container\"\u003e\n    \u003cdiv class=\"hero\"\u003e\n      \u003ch1\u003eYou've experienced ATHLOUN style.\u003cbr\u003eNow discover ATHLOUN values.\u003c\/h1\u003e\n      \u003cp\u003eCompare corporate piece vs. retail collection\u003c\/p\u003e\n    \u003c\/div\u003e\n\n    \u003cdiv class=\"form-container\" id=\"form-wrapper\"\u003e\n      \u003ch2 style=\"text-align: center; margin-top: 0; color: #333;\"\u003eInner Circle Program\u003c\/h2\u003e\n      \u003cp style=\"text-align: center; color: #666;\"\u003eEnter your company code and work email to verify and activate your 15% discount\u003c\/p\u003e\n\n      \u003cform id=\"verification-form\"\u003e\n        \u003cdiv class=\"form-group\"\u003e\n          \u003clabel for=\"company_code\"\u003eCompany Code *\u003c\/label\u003e\n          \u003cinput\n            type=\"text\"\n            id=\"company_code\"\n            placeholder=\"e.g., LEAD2024\"\n            required\n          \/\u003e\n          \u003cdiv class=\"error\" id=\"code-error\"\u003e\u003c\/div\u003e\n        \u003c\/div\u003e\n\n        \u003cdiv class=\"form-group\"\u003e\n          \u003clabel for=\"work_email\"\u003eWork Email *\u003c\/label\u003e\n          \u003cinput\n            type=\"email\"\n            id=\"work_email\"\n            placeholder=\"name@company.com\"\n            required\n          \/\u003e\n          \u003cdiv class=\"error\" id=\"email-error\"\u003e\u003c\/div\u003e\n        \u003c\/div\u003e\n\n        \u003cdiv class=\"success-message\" id=\"success-message\"\u003e\n          ✓ Success! Your discount code has been generated. Check the code below.\n        \u003c\/div\u003e\n\n        \u003cbutton type=\"submit\" id=\"submit-btn\"\u003eVerify \u0026 Activate\u003c\/button\u003e\n      \u003c\/form\u003e\n\n      \u003cdiv id=\"code-display\" style=\"display: none; margin-top: 30px;\"\u003e\n        \u003cdiv style=\"background: white; border: 3px solid #cd853f; padding: 30px; border-radius: 8px;\"\u003e\n          \u003cp style=\"color: #666; margin: 0 0 10px 0;\"\u003eYour Discount Code:\u003c\/p\u003e\n          \u003ch1 id=\"display-code\" style=\"color: #cd853f; margin: 0; letter-spacing: 2px; font-size: 32px;\"\u003e\u003c\/h1\u003e\n          \u003cbutton type=\"button\" id=\"copy-btn\" onclick=\"copyCode()\" style=\"margin-top: 10px; background: #cd853f;\"\u003e\n            Copy Code\n          \u003c\/button\u003e\n        \u003c\/div\u003e\n      \u003c\/div\u003e\n    \u003c\/div\u003e\n\n    \u003cdiv class=\"benefits\"\u003e\n      \u003ch3\u003e✓ Your Inner Circle Benefits\u003c\/h3\u003e\n      \u003cul\u003e\n        \u003cli\u003e\u003cstrong\u003e15% OFF\u003c\/strong\u003e all purchases\u003c\/li\u003e\n        \u003cli\u003e\u003cstrong\u003eFree shipping\u003c\/strong\u003e on all orders\u003c\/li\u003e\n        \u003cli\u003e\u003cstrong\u003eEarly access\u003c\/strong\u003e to new collections\u003c\/li\u003e\n        \u003cli\u003e\u003cstrong\u003eLifetime discount\u003c\/strong\u003e - never expires\u003c\/li\u003e\n      \u003c\/ul\u003e\n      \u003cp style=\"font-size: 12px; color: #999; margin-top: 20px;\"\u003eNote: NO COD ORDERS\u003c\/p\u003e\n    \u003c\/div\u003e\n  \u003c\/div\u003e\n\u003c\/div\u003e\n\n\u003cscript\u003e\nconst API_BASE = 'https:\/\/athloun-inner-circle-api.onrender.com\/api';\n\nfunction showError(id, msg) {\n  const el = document.getElementById(id);\n  if (el) {\n    el.textContent = msg;\n    el.style.display = 'block';\n  }\n}\n\nfunction clearErrors() {\n  ['code-error', 'email-error'].forEach(id =\u003e {\n    const el = document.getElementById(id);\n    if (el) {\n      el.style.display = 'none';\n      el.textContent = '';\n    }\n  });\n}\n\n\/\/ PAGE LOAD\ndocument.addEventListener('DOMContentLoaded', () =\u003e {\n  const params = new URLSearchParams(window.location.search);\n  const token = params.get('token');\n  const email = params.get('email');\n\n  if (token \u0026\u0026 email) {\n    \/\/ verification mode\n    const app = document.getElementById('app');\n    app.innerHTML = '\u003cdiv style=\"text-align:center;padding:60px 20px;\"\u003e\u003ch2\u003eVerifying...\u003c\/h2\u003e\u003c\/div\u003e';\n    verifyEmail(token, email);\n    return;\n  }\n\n  \/\/ normal form mode\n  const form = document.getElementById('verification-form');\n  if (!form) return;\n\n  form.addEventListener('submit', async (e) =\u003e {\n    e.preventDefault();\n\n    clearErrors();\n\n    const company_code = document.getElementById('company_code').value.trim();\n    const work_email = document.getElementById('work_email').value.trim();\n    const btn = document.getElementById('submit-btn');\n\n    if (!company_code) {\n      showError('code-error', 'Please enter company code');\n      return;\n    }\n    if (!work_email) {\n      showError('email-error', 'Please enter work email');\n      return;\n    }\n\n    btn.disabled = true;\n    btn.textContent = 'Sending...';\n\n    try {\n      const resp = await fetch(`${API_BASE}\/verify-form`, {\n        method: 'POST',\n        headers: {\n          'Content-Type': 'application\/json',\n          'Accept': 'application\/json'\n        },\n        body: JSON.stringify({ company_code, work_email })\n      });\n\n      const data = await resp.json().catch(() =\u003e ({}));\n\n      if (resp.ok \u0026\u0026 data.success) {\n        document.getElementById('verification-form').style.display = 'none';\n        const msg = document.getElementById('success-message');\n        msg.textContent = data.message || 'Check your email for the verification link.';\n        msg.style.display = 'block';\n      } else {\n        const err = data.error || 'Something went wrong. Please try again.';\n        if (err.toLowerCase().includes('email')) {\n          showError('email-error', err);\n        } else {\n          showError('code-error', err);\n        }\n        btn.disabled = false;\n        btn.textContent = 'Verify \u0026 Activate';\n      }\n    } catch (err) {\n      console.error('Fetch error:', err);\n      showError('code-error', 'Connection error. Please try again.');\n      btn.disabled = false;\n      btn.textContent = 'Verify \u0026 Activate';\n    }\n  });\n});\n\n\/\/ VERIFY EMAIL FLOW\nasync function verifyEmail(token, email) {\n  try {\n    const resp = await fetch(\n      `${API_BASE}\/verify-email?token=${encodeURIComponent(token)}\u0026email=${encodeURIComponent(email)}`\n    );\n    const data = await resp.json().catch(() =\u003e ({}));\n\n    if (resp.ok \u0026\u0026 data.success) {\n      const html = `\n        \u003cdiv style=\"max-width: 600px; margin: 0 auto; padding: 60px 20px; text-align: center;\"\u003e\n          \u003cdiv style=\"font-size: 80px; margin-bottom: 20px;\"\u003e✓\u003c\/div\u003e\n          \u003ch1 style=\"color: #27ae60; margin: 0 0 10px 0;\"\u003eEmail Verified!\u003c\/h1\u003e\n          \u003cp style=\"color: #666; margin: 20px 0;\"\u003eWelcome to ATHLOUN Inner Circle, ${data.first_name || 'Member'}!\u003c\/p\u003e\n\n          \u003cdiv style=\"background: white; border: 3px solid #cd853f; padding: 30px; border-radius: 8px; margin: 30px 0;\"\u003e\n            \u003cp style=\"color: #666; margin: 0 0 10px 0;\"\u003eYour Discount Code:\u003c\/p\u003e\n            \u003ch1 style=\"color: #cd853f; margin: 0; letter-spacing: 2px; font-size: 32px;\"\u003e${data.discount_code || ''}\u003c\/h1\u003e\n            \u003cbutton onclick=\"navigator.clipboard.writeText('${data.discount_code || ''}'); alert('Copied!')\"\n              style=\"background: #cd853f; color: white; padding: 10px 20px; border: none; border-radius: 4px; cursor: pointer; margin-top: 10px;\"\u003e\n              Copy Code\n            \u003c\/button\u003e\n          \u003c\/div\u003e\n\n          \u003ch3 style=\"color: #333;\"\u003eHow to Use Your Discount:\u003c\/h3\u003e\n          \u003col style=\"text-align: left; display: inline-block; color: #666;\"\u003e\n            \u003cli\u003eBrowse our store\u003c\/li\u003e\n            \u003cli\u003eAdd items to your cart\u003c\/li\u003e\n            \u003cli\u003eAt checkout, enter code: \u003cstrong\u003e${data.discount_code || ''}\u003c\/strong\u003e\u003c\/li\u003e\n            \u003cli\u003eGet 15% off instantly!\u003c\/li\u003e\n          \u003c\/ol\u003e\n        \u003c\/div\u003e\n      `;\n      document.getElementById('app').innerHTML = html;\n    } else {\n      const err = data.error || 'Verification failed.';\n      document.getElementById('app').innerHTML = `\n        \u003cdiv style=\"max-width: 600px; margin: 0 auto; padding: 60px 20px; text-align: center;\"\u003e\n          \u003ch1 style=\"color: #dc3545;\"\u003eVerification Failed\u003c\/h1\u003e\n          \u003cp\u003e${err}\u003c\/p\u003e\n          \u003ca href=\"\/pages\/insider\" style=\"color: #cd853f;\"\u003eTry again\u003c\/a\u003e\n        \u003c\/div\u003e\n      `;\n    }\n  } catch (err) {\n    console.error('Verify email error:', err);\n    document.getElementById('app').innerHTML = `\n      \u003cdiv style=\"max-width: 600px; margin: 0 auto; padding: 60px 20px; text-align: center;\"\u003e\n        \u003ch1 style=\"color: #dc3545;\"\u003eError\u003c\/h1\u003e\n        \u003cp\u003eAn error occurred. Please try again.\u003c\/p\u003e\n        \u003ca href=\"\/pages\/insider\" style=\"color: #cd853f;\"\u003eTry again\u003c\/a\u003e\n      \u003c\/div\u003e\n    `;\n  }\n}\n\u003c\/script\u003e","text_alignment":"center"}}},"order":["main","custom_liquid_RcBJyD"]}