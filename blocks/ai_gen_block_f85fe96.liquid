{% doc %}
  @prompt
    Create a Shopify OS 2.0 customizable section for displaying lifestyle product images.
    
    Requirements:
    
    * Support 5–6 dynamic lifestyle images
    * Each image should be configurable from the Shopify Theme Editor
    * Add an option to switch between two layouts:
    
      1. Banner Layout → images stacked vertically one below another
      2. Slider Layout → horizontal carousel/slider
    * Layout selection should be configurable through section settings
    * Fully responsive on mobile and desktop
    * Use Shopify blocks for dynamic image management
    * Include optional heading and text support
    * Optimize images with lazy loading
    * Modern clean UI suitable for premium Shopify stores
    
    The section should be merchant-friendly and easy to customize from the Shopify Customizer.
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-lifestyle-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 40px 20px;
  }

  .ai-lifestyle-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }

  .ai-lifestyle-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: 40px;
  }

  .ai-lifestyle-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 16px 0;
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-style: {{ block.settings.heading_font.style }};
  }

  .ai-lifestyle-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    max-width: 700px;
    {% if block.settings.text_alignment == 'center' %}
      margin-left: auto;
      margin-right: auto;
    {% endif %}
  }

  .ai-lifestyle-banner-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.image_spacing }}px;
  }

  .ai-lifestyle-slider-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-lifestyle-slider-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.image_spacing }}px;
    transition: transform 0.5s ease;
  }

  .ai-lifestyle-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    background-color: #f4f4f4;
  }

  .ai-lifestyle-slider-{{ ai_gen_id }} .ai-lifestyle-image-wrapper-{{ ai_gen_id }} {
    flex: 0 0 100%;
    min-width: 100%;
  }

  .ai-lifestyle-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    {% if block.settings.image_aspect_ratio != 'natural' %}
      aspect-ratio: {{ block.settings.image_aspect_ratio }};
    {% endif %}
  }

  .ai-lifestyle-placeholder-{{ ai_gen_id }} {
    width: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    {% if block.settings.image_aspect_ratio != 'natural' %}
      aspect-ratio: {{ block.settings.image_aspect_ratio }};
    {% else %}
      min-height: 400px;
    {% endif %}
  }

  .ai-lifestyle-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
    opacity: 0.3;
  }

  .ai-lifestyle-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-lifestyle-slider-controls-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    margin-top: 30px;
  }

  .ai-lifestyle-slider-button-{{ ai_gen_id }} {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: {{ block.settings.control_background }};
    border: 1px solid {{ block.settings.control_border }};
    color: {{ block.settings.control_color }};
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .ai-lifestyle-slider-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.control_hover_background }};
    transform: scale(1.05);
  }

  .ai-lifestyle-slider-button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-lifestyle-slider-button-{{ ai_gen_id }}:disabled:hover {
    transform: none;
  }

  .ai-lifestyle-slider-dots-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
  }

  .ai-lifestyle-dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: {{ block.settings.control_border }};
    border: none;
    cursor: pointer;
    padding: 0;
    transition: all 0.3s ease;
  }

  .ai-lifestyle-dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.control_background }};
    transform: scale(1.2);
  }

  @media screen and (min-width: 750px) {
    .ai-lifestyle-section-{{ ai_gen_id }} {
      padding: 60px 40px;
    }

    .ai-lifestyle-header-{{ ai_gen_id }} {
      margin-bottom: 60px;
    }

    .ai-lifestyle-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 1.3);
    }

    .ai-lifestyle-text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.text_size }}px * 1.1);
    }

    .ai-lifestyle-slider-{{ ai_gen_id }} .ai-lifestyle-image-wrapper-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - {{ block.settings.image_spacing }}px) / 2);
      min-width: calc((100% - {{ block.settings.image_spacing }}px) / 2);
    }
  }

  @media screen and (min-width: 990px) {
    .ai-lifestyle-slider-{{ ai_gen_id }} .ai-lifestyle-image-wrapper-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - ({{ block.settings.image_spacing }}px * 2)) / 3);
      min-width: calc((100% - ({{ block.settings.image_spacing }}px * 2)) / 3);
    }
  }
{% endstyle %}

<lifestyle-images-{{ ai_gen_id }}
  class="ai-lifestyle-section-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
  data-layout="{{ block.settings.layout }}"
>
  <div class="ai-lifestyle-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.text != blank %}
      <div class="ai-lifestyle-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-lifestyle-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.text != blank %}
          <div class="ai-lifestyle-text-{{ ai_gen_id }}">{{ block.settings.text }}</div>
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.layout == 'banner' %}
      <div class="ai-lifestyle-banner-{{ ai_gen_id }}">
        {% for i in (1..6) %}
          {% assign image_key = 'image_' | append: i %}
          {% assign image = block.settings[image_key] %}
          
          {% if image != blank %}
            <div class="ai-lifestyle-image-wrapper-{{ ai_gen_id }}">
              <img
                src="{{ image | image_url: width: 1400 }}"
                srcset="{{ image | image_url: width: 375 }} 375w,
                        {{ image | image_url: width: 750 }} 750w,
                        {{ image | image_url: width: 1100 }} 1100w,
                        {{ image | image_url: width: 1400 }} 1400w"
                sizes="(min-width: 990px) 1400px, (min-width: 750px) 100vw, 100vw"
                alt="{{ image.alt | escape }}"
                loading="lazy"
                width="{{ image.width }}"
                height="{{ image.height }}"
                class="ai-lifestyle-image-{{ ai_gen_id }}"
              >
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <div class="ai-lifestyle-slider-{{ ai_gen_id }}">
        <div class="ai-lifestyle-slider-track-{{ ai_gen_id }}">
          {% assign has_images = false %}
          {% for i in (1..6) %}
            {% assign image_key = 'image_' | append: i %}
            {% assign image = block.settings[image_key] %}
            
            {% if image != blank %}
              {% assign has_images = true %}
              <div class="ai-lifestyle-image-wrapper-{{ ai_gen_id }}">
                <img
                  src="{{ image | image_url: width: 800 }}"
                  srcset="{{ image | image_url: width: 375 }} 375w,
                          {{ image | image_url: width: 550 }} 550w,
                          {{ image | image_url: width: 750 }} 750w,
                          {{ image | image_url: width: 800 }} 800w"
                  sizes="(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw"
                  alt="{{ image.alt | escape }}"
                  loading="lazy"
                  width="{{ image.width }}"
                  height="{{ image.height }}"
                  class="ai-lifestyle-image-{{ ai_gen_id }}"
                >
              </div>
            {% endif %}
          {% endfor %}

          {% unless has_images %}
            <div class="ai-lifestyle-image-wrapper-{{ ai_gen_id }}">
              <div class="ai-lifestyle-placeholder-{{ ai_gen_id }}">
                {{ 'lifestyle-apparel-1' | placeholder_svg_tag }}
                <div class="ai-lifestyle-empty-state-{{ ai_gen_id }}">
                  Add lifestyle images to get started
                </div>
              </div>
            </div>
          {% endunless %}
        </div>

        {% if has_images %}
          <div class="ai-lifestyle-slider-controls-{{ ai_gen_id }}">
            <button
              class="ai-lifestyle-slider-button-{{ ai_gen_id }} ai-lifestyle-prev-{{ ai_gen_id }}"
              aria-label="Previous slide"
            >
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="12 4 6 10 12 16"></polyline>
              </svg>
            </button>

            <div class="ai-lifestyle-slider-dots-{{ ai_gen_id }}"></div>

            <button
              class="ai-lifestyle-slider-button-{{ ai_gen_id }} ai-lifestyle-next-{{ ai_gen_id }}"
              aria-label="Next slide"
            >
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="8 4 14 10 8 16"></polyline>
              </svg>
            </button>
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</lifestyle-images-{{ ai_gen_id }}>

<script>
  (function() {
    class LifestyleImages{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.slidesPerView = 1;
      }

      connectedCallback() {
        const layout = this.dataset.layout;
        
        if (layout === 'slider') {
          this.initSlider();
        }
      }

      initSlider() {
        this.track = this.querySelector('.ai-lifestyle-slider-track-{{ ai_gen_id }}');
        this.slides = this.querySelectorAll('.ai-lifestyle-image-wrapper-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-lifestyle-prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-lifestyle-next-{{ ai_gen_id }}');
        this.dotsContainer = this.querySelector('.ai-lifestyle-slider-dots-{{ ai_gen_id }}');

        if (!this.track || this.slides.length === 0) return;

        this.updateSlidesPerView();
        this.createDots();
        this.updateSlider();

        this.prevButton.addEventListener('click', () => this.prevSlide());
        this.nextButton.addEventListener('click', () => this.nextSlide());

        window.addEventListener('resize', () => {
          this.updateSlidesPerView();
          this.createDots();
          this.updateSlider();
        });
      }

      updateSlidesPerView() {
        const width = window.innerWidth;
        if (width >= 990) {
          this.slidesPerView = 3;
        } else if (width >= 750) {
          this.slidesPerView = 2;
        } else {
          this.slidesPerView = 1;
        }
      }

      createDots() {
        if (!this.dotsContainer) return;
        
        this.dotsContainer.innerHTML = '';
        const totalDots = Math.ceil(this.slides.length / this.slidesPerView);

        for (let i = 0; i < totalDots; i++) {
          const dot = document.createElement('button');
          dot.classList.add('ai-lifestyle-dot-{{ ai_gen_id }}');
          dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
          
          if (i === 0) {
            dot.classList.add('active');
          }

          dot.addEventListener('click', () => {
            this.currentSlide = i * this.slidesPerView;
            this.updateSlider();
          });

          this.dotsContainer.appendChild(dot);
        }
      }

      prevSlide() {
        if (this.currentSlide > 0) {
          this.currentSlide -= this.slidesPerView;
          if (this.currentSlide < 0) this.currentSlide = 0;
          this.updateSlider();
        }
      }

      nextSlide() {
        const maxSlide = this.slides.length - this.slidesPerView;
        if (this.currentSlide < maxSlide) {
          this.currentSlide += this.slidesPerView;
          if (this.currentSlide > maxSlide) this.currentSlide = maxSlide;
          this.updateSlider();
        }
      }

      updateSlider() {
        const slideWidth = this.slides[0].offsetWidth;
        const gap = parseInt(getComputedStyle(this.track).gap) || 0;
        const offset = -(this.currentSlide * (slideWidth + gap));
        
        this.track.style.transform = 'translateX(' + offset + 'px)';

        if (this.prevButton) {
          this.prevButton.disabled = this.currentSlide === 0;
        }

        if (this.nextButton) {
          const maxSlide = this.slides.length - this.slidesPerView;
          this.nextButton.disabled = this.currentSlide >= maxSlide;
        }

        const dots = this.querySelectorAll('.ai-lifestyle-dot-{{ ai_gen_id }}');
        const activeDotIndex = Math.floor(this.currentSlide / this.slidesPerView);
        
        dots.forEach(function(dot, index) {
          if (index === activeDotIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }
    }

    customElements.define('lifestyle-images-{{ ai_gen_id }}', LifestyleImages{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Lifestyle images",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout style",
      "options": [
        {
          "value": "banner",
          "label": "Banner (stacked)"
        },
        {
          "value": "slider",
          "label": "Slider (carousel)"
        }
      ],
      "default": "slider"
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image aspect ratio",
      "options": [
        {
          "value": "natural",
          "label": "Natural"
        },
        {
          "value": "1/1",
          "label": "Square (1:1)"
        },
        {
          "value": "4/3",
          "label": "Landscape (4:3)"
        },
        {
          "value": "16/9",
          "label": "Wide (16:9)"
        },
        {
          "value": "3/4",
          "label": "Portrait (3:4)"
        }
      ],
      "default": "4/3"
    },
    {
      "type": "range",
      "id": "image_spacing",
      "label": "Image spacing",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image border radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Lifestyle collection"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Discover our sustainable performance apparel in action</p>"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image 3"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "Image 4"
    },
    {
      "type": "image_picker",
      "id": "image_5",
      "label": "Image 5"
    },
    {
      "type": "image_picker",
      "id": "image_6",
      "label": "Image 6"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "helvetica_n4"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
